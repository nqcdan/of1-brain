# Template for machine-local secrets.
# Copy to .claude/secrets.env (gitignored, chmod 600) and add your own KEY=value pairs.
#   cp secrets.example.env .claude/secrets.env && chmod 600 .claude/secrets.env
# Load into the shell with: set -a; . .claude/secrets.env; set +a
# Never commit the real .claude/secrets.env — credentials must stay out of version control.
